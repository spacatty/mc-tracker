# Required in production. Generate separate values with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
CRON_SECRET=

# SQLite database path. Use persistent storage in production.
SQLITE_PATH=./data/mc-tracker.sqlite

# Optional AI import support (free-form text parsing; CSV/JSON import works without it).
# Any OpenAI-compatible endpoint works. Defaults target OpenRouter.
AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
# Cheap, fast default with strict JSON-schema output. Override per deployment.
AI_MODEL=deepseek/deepseek-v4.1-flash
# json_schema (strict, OpenRouter default) or json_object (schema sent in the prompt;
# use this for DeepSeek's own API with AI_BASE_URL=https://api.deepseek.com and its model id).
# AI_STRUCTURED_OUTPUT=json_schema
AI_IMPORT_MAX_INPUT_CHARS=20000
AI_IMPORT_MAX_OUTPUT_TOKENS=8000

# Legacy names still read as fallbacks for AI_API_KEY / AI_MODEL.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=MC Tracker

# Leak prevention. All /api JSON, user-facing error strings and AI requests are masked.
# Kinds: secret,email,url_credentials,ip,domain,denylist (default: all).
# REDACT_KINDS=secret,email,url_credentials,ip,domain,denylist
# Extra terms that must never leave the server: literals or /regex/flags, comma separated.
# REDACT_DENYLIST=internal-codename,/corp-\d+/i
